# Referência dos valores usados em desenvolvimento — já embutidos no
# docker-compose.yml para o serviço `api`. Este arquivo documenta o que
# existe; em produção, cada variável vem do secrets manager do provedor de
# hospedagem, nunca de um arquivo .env commitado.

DATABASE_URL=postgresql://fincontrol:fincontrol@localhost:5432/fincontrol?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-troque-em-producao
JWT_REFRESH_SECRET=dev-refresh-secret-troque-em-producao
